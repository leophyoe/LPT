OID_MAP: Dict[str, Tuple[str, str]] = {
    # Public Key Algorithms
    "1.2.840.113549.1.1.1": ("RSA", "Public Key"),
    "1.2.840.10045.2.1": ("EC", "Elliptic Curve Public Key"),
    "1.3.101.112": ("Ed25519", "Edwards Curve 25519"),
    "1.3.101.113": ("Ed448", "Edwards Curve 448"),
    "1.2.840.10040.4.1": ("DSA", "Digital Signature Algorithm"),
    # Named Elliptic Curves
    "1.2.840.10045.3.1.7": ("prime256v1 (secp256r1)", "256 bits"),
    "1.3.132.0.34": ("secp384r1", "384 bits"),
    "1.3.132.0.35": ("secp521r1", "521 bits"),
    "1.3.132.0.10": ("secp256k1", "256 bits"),
    # Signature Algorithms
    "1.2.840.113549.1.1.4": ("md5WithRSAEncryption", "Insecure / Broken (MD5)"),
    "1.2.840.113549.1.1.5": ("sha1WithRSAEncryption", "Weak / Deprecated (SHA-1)"),
    "1.2.840.113549.1.1.11": ("sha256WithRSAEncryption", "Secure (SHA-256)"),
    "1.2.840.113549.1.1.12": ("sha384WithRSAEncryption", "Secure (SHA-384)"),
    "1.2.840.113549.1.1.13": ("sha512WithRSAEncryption", "Secure (SHA-512)"),
    "1.2.840.10045.4.1": ("ecdsa-with-SHA1", "Weak / Deprecated (SHA-1)"),
