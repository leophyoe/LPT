    def _on_selection_changed(self):
        selected = self.table.selectedItems()
        if not selected:
            self.details_edit.clear()
            return
        row = selected[0].row()
        if row < len(self.visible_findings):
            f = self.visible_findings[row]
            conf_val = getattr(f, "confidence", 1.0) or 1.0
            assess_text = f"#{f.assessment_id}" if getattr(f, "assessment_id", None) else "Global Project"
            raw_val = f.validation_status.value if hasattr(f.validation_status, "value") else str(f.validation_status)
            unverified_tag = " `[UNVERIFIED - PENDING EVIDENCE]`" if raw_val in ("unverified", "needs_validation") else ""

            text = (
                f"### {sanitize_text(f.title)}{unverified_tag}\n\n"
                f"**Severity:** {f.severity.value.upper()} | **Validation Status:** {raw_val.upper()} | **Confidence:** {conf_val:.1f}\n"
                f"**Target Asset:** {f.affected_asset} | **Service:** {f.affected_port_service}\n"
                f"**Assessment:** {assess_text} | **Source Tool:** {f.source_tool or 'Manual'} | **Execution ID:** #{f.execution_id or 'N/A'}\n\n"
                f"#### Description:\n{sanitize_text(f.description) or 'No description provided.'}\n\n"
                f"#### Reproduction Steps:\n{sanitize_text(f.reproduction_steps) or 'N/A'}\n\n"
                f"#### Recommended Remediation:\n{sanitize_text(f.remediation) or 'N/A'}\n"
            )

            # Query and verify cryptographic evidence records
            if self.active_project_id is not None:
                all_ev = self.db.list_evidence(self.active_project_id)
                evidence_records = [
                    ev for ev in all_ev
                    if ev.finding_id == f.id or (f.execution_id and ev.execution_id == f.execution_id)
                ]
                text += "\n#### Cryptographic Evidence & Integrity Verification:\n"
                if evidence_records:
                    for ev in evidence_records:
                        is_valid, msg = self.db.verify_evidence_integrity(ev)
                        badge = "✅ Verified" if is_valid else "⚠️ Unverified / Warning"
                        text += (
                            f"- **Evidence #{ev.id}** — `{ev.file_path}` ({badge})\n"
                            f"  - **SHA-256:** `{ev.sha256_hash}`\n"
                            f"  - **Integrity Status:** {msg}\n"
                            f"  - **Description:** {sanitize_text(ev.description) or 'Assessment artifact'}\n"
                        )
                        if (ev.mime_type and ev.mime_type.startswith("image/")) or Path(ev.file_path).suffix.lower() in (".png", ".jpg", ".jpeg"):
                            text += f"  - **Figure:** 🖼️ Screenshot POC attached: [{Path(ev.file_path).name}](file://{Path(ev.file_path).resolve()})\n"
                else:
                    text += "_No standalone cryptographic evidence records attached to this finding._\n"

            self.details_edit.setMarkdown(text)

