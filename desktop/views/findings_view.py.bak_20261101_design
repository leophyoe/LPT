        clean_name = "".join(c if c.isalnum() or c in ("-", "_") else "_" for c in project.name)
        default_filename = f"CPENT_ENGAGEMENT_{project.engagement_id or clean_name}.zip"

        file_path, _ = QFileDialog.getSaveFileName(
            self,
