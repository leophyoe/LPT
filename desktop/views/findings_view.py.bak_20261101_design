class FindingEditDialog(QDialog):
    """Dialog for creating or editing a Security Finding (Phase 7)."""

    def __init__(self, finding: Optional[Finding] = None, assessments: list[Assessment] = None, parent=None):
        super().__init__(parent)
        self.finding = finding
        self.assessments = assessments or []
        self.setWindowTitle("Edit Finding" if finding else "New Security Finding")
        self.setMinimumWidth(580)

        layout = QFormLayout(self)
        layout.setSpacing(10)

        self.title_input = QLineEdit(finding.title if finding else "")
        self.title_input.setPlaceholderText("e.g. Unauthenticated Remote Code Execution via Log4j")
        layout.addRow("Finding Title *:", self.title_input)

        row_meta = QHBoxLayout()
        self.severity_combo = QComboBox()
        for sev in FindingSeverity:
            self.severity_combo.addItem(sev.value.upper(), sev)
        if finding:
            idx = self.severity_combo.findData(finding.severity)
            if idx >= 0:
                self.severity_combo.setCurrentIndex(idx)
        else:
            self.severity_combo.setCurrentIndex(2)  # Medium default

        self.status_combo = QComboBox()
        statuses = [
            ("New", ValidationStatus.NEW),
            ("Confirmed", ValidationStatus.CONFIRMED),
            ("False Positive", ValidationStatus.FALSE_POSITIVE),
            ("Remediation in Progress", ValidationStatus.REMEDIATION_IN_PROGRESS),
            ("Resolved", ValidationStatus.RESOLVED),
            ("Accepted Risk", ValidationStatus.ACCEPTED_RISK),
            ("Unverified", ValidationStatus.UNVERIFIED),
        ]
        for label, st in statuses:
            self.status_combo.addItem(label, st)
        if finding:
            idx = self.status_combo.findData(finding.validation_status)
            if idx >= 0:
                self.status_combo.setCurrentIndex(idx)

        row_meta.addWidget(QLabel("Severity:"))
        row_meta.addWidget(self.severity_combo)
        row_meta.addWidget(QLabel("Status:"))
        row_meta.addWidget(self.status_combo)
        layout.addRow("Classification:", row_meta)

        row_target = QHBoxLayout()
        self.asset_input = QLineEdit(finding.affected_asset if finding else "")
        self.asset_input.setPlaceholderText("IP / Hostname (e.g. 192.168.1.10)")
        self.port_input = QLineEdit(finding.affected_port_service if finding else "")
        self.port_input.setPlaceholderText("Port / Service (e.g. 443/https)")
        self.port_input.setMaximumWidth(140)
        row_target.addWidget(self.asset_input)
        row_target.addWidget(self.port_input)
        layout.addRow("Target Asset & Service:", row_target)

        row_assess = QHBoxLayout()
        self.assess_combo = QComboBox()
        self.assess_combo.addItem("None / Global", None)
        for a in self.assessments:
            self.assess_combo.addItem(f"#{a.id} - {a.name}", a.id)
        if finding and finding.assessment_id:
            idx = self.assess_combo.findData(finding.assessment_id)
            if idx >= 0:
                self.assess_combo.setCurrentIndex(idx)
        row_assess.addWidget(self.assess_combo)

        self.confidence_spin = QDoubleSpinBox()
        self.confidence_spin.setRange(0.0, 1.0)
        self.confidence_spin.setSingleStep(0.1)
        self.confidence_spin.setValue(getattr(finding, "confidence", 1.0) if finding else 1.0)
        row_assess.addWidget(QLabel("Confidence:"))
        row_assess.addWidget(self.confidence_spin)
        layout.addRow("Assessment & Confidence:", row_assess)

        self.desc_input = QTextEdit()
        self.desc_input.setPlaceholderText("Detailed technical description of vulnerability...")
        self.desc_input.setText(finding.description if finding else "")
        self.desc_input.setMaximumHeight(80)
        layout.addRow("Description:", self.desc_input)

        self.repro_input = QTextEdit()
        self.repro_input.setPlaceholderText("Step-by-step reproduction instructions...")
        self.repro_input.setText(finding.reproduction_steps if finding else "")
        self.repro_input.setMaximumHeight(70)
        layout.addRow("Reproduction Steps:", self.repro_input)

        self.remed_input = QTextEdit()
        self.remed_input.setPlaceholderText("Actionable remediation guidance and patching instructions...")
        self.remed_input.setText(finding.remediation if finding else "")
        self.remed_input.setMaximumHeight(70)
        layout.addRow("Remediation Guidance:", self.remed_input)

        btn_box = QHBoxLayout()
        btn_cancel = QPushButton("Cancel")
        btn_cancel.clicked.connect(self.reject)
        btn_ok = QPushButton("Save Finding" if finding else "Create Finding")
        btn_ok.setProperty("class", "action-primary")
        btn_ok.clicked.connect(self._validate_and_accept)

        btn_box.addStretch()
        btn_box.addWidget(btn_cancel)
        btn_box.addWidget(btn_ok)
        layout.addRow(btn_box)

    def _validate_and_accept(self):
        if not self.title_input.text().strip():
            QMessageBox.warning(self, "Validation Error", "Finding title is required.")
            return
        self.accept()

    def get_data(self) -> dict:
        return {
            "title": self.title_input.text().strip(),
            "severity": self.severity_combo.currentData(),
            "validation_status": self.status_combo.currentData(),
            "affected_asset": self.asset_input.text().strip(),
            "affected_port_service": self.port_input.text().strip(),
            "assessment_id": self.assess_combo.currentData(),
            "confidence": self.confidence_spin.value(),
            "description": sanitize_text(self.desc_input.toPlainText().strip()),
            "reproduction_steps": sanitize_text(self.repro_input.toPlainText().strip()),
            "remediation": sanitize_text(self.remed_input.toPlainText().strip()),
        }


