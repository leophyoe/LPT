    def load_findings(self, project_id: Optional[int]):
        self.active_project_id = project_id
        self.export_status.setText("")

        if project_id is None:
            self._auto_report_signature = None
            self._auto_report_pending_project = None
            self.findings_cache = []
            self.visible_findings = []
            self.assessments_cache = []
            self.combo_filter_assessment.clear()
            self.combo_filter_assessment.addItem("All Assessments", None)
            self.table.setRowCount(0)
            self.details_edit.clear()
            return

        # Load assessments for combo filter
        self.assessments_cache = self.db.list_assessments(project_id)
        current_data = self.combo_filter_assessment.currentData()
        self.combo_filter_assessment.blockSignals(True)
        self.combo_filter_assessment.clear()
        self.combo_filter_assessment.addItem("All Assessments", None)
        for a in self.assessments_cache:
            self.combo_filter_assessment.addItem(f"#{a.id} - {a.name}", a.id)
        if current_data is not None:
            idx = self.combo_filter_assessment.findData(current_data)
            if idx >= 0:
                self.combo_filter_assessment.setCurrentIndex(idx)
        self.combo_filter_assessment.blockSignals(False)

        # Query all findings for project
        self.findings_cache = self.db.list_findings(project_id)
        self._apply_filters()

        if self.auto_report_checkbox.isChecked():
            self._schedule_auto_report(project_id)

    def _apply_filters(self):
        """Filters cached findings by assessment, severity, and status."""
        assessment_id = self.combo_filter_assessment.currentData()
        sev_filter = self.combo_filter_severity.currentData()
        status_filter = self.combo_filter_status.currentData()

        filtered = []
        for f in self.findings_cache:
            if assessment_id is not None and getattr(f, "assessment_id", None) != assessment_id:
                continue
            if sev_filter is not None and f.severity != sev_filter:
                continue
            if status_filter is not None and f.validation_status != status_filter:
                continue
            filtered.append(f)

        self.visible_findings = filtered
        self.table.setRowCount(len(filtered))

        for row, f in enumerate(filtered):
            self.table.setItem(row, 0, QTableWidgetItem(str(f.id)))

            sev_item = QTableWidgetItem(f.severity.value.upper())
            color = self.SEVERITY_COLORS.get(f.severity, QColor("#94a3b8"))
            sev_item.setForeground(color)
            self.table.setItem(row, 1, sev_item)

            self.table.setItem(row, 2, QTableWidgetItem(f.title))
            self.table.setItem(row, 3, QTableWidgetItem(f"{f.affected_asset} ({f.affected_port_service})"))

            raw_stat = f.validation_status.value if hasattr(f.validation_status, "value") else str(f.validation_status)
            val_item = QTableWidgetItem(raw_stat.replace("_", " ").upper())
            val_color_hex = VALIDATION_COLORS_HEX.get(raw_stat.upper(), CPENTTheme.SECONDARY_TEXT)
            val_item.setForeground(QColor(val_color_hex))
            self.table.setItem(row, 4, val_item)

            conf_val = getattr(f, "confidence", 1.0) or 1.0
            self.table.setItem(row, 5, QTableWidgetItem(f"{conf_val:.1f}"))

            assess_label = f"#{f.assessment_id}" if getattr(f, "assessment_id", None) else "Global"
            self.table.setItem(row, 6, QTableWidgetItem(assess_label))

        if filtered:
            self.table.selectRow(0)
            self._on_selection_changed()
        else:
            self.details_edit.clear()

    def _on_new_finding(self):
        if self.active_project_id is None:
            QMessageBox.warning(self, "No Project Selected", "Select an active project first.")
            return

        dlg = FindingEditDialog(assessments=self.assessments_cache, parent=self)
        if dlg.exec() == QDialog.Accepted:
            data = dlg.get_data()
            finding = Finding(
                project_id=self.active_project_id,
                title=data["title"],
                severity=data["severity"],
                validation_status=data["validation_status"],
                affected_asset=data["affected_asset"],
                affected_port_service=data["affected_port_service"],
                assessment_id=data["assessment_id"],
                confidence=data["confidence"],
                description=data["description"],
                reproduction_steps=data["reproduction_steps"],
                remediation=data["remediation"],
            )
            # Deduplicate on repeated creations / imports
            created = self.db.upsert_finding_deduplicated(finding)
            self.load_findings(self.active_project_id)
            self.export_status.setText(f"✓ Saved finding #{created.id} '{created.title}'")

    def _on_edit_finding(self):
        if self.active_project_id is None:
            return
        selected = self.table.selectedItems()
        if not selected:
            QMessageBox.warning(self, "No Selection", "Please select a finding to edit.")
            return
        row = selected[0].row()
        if row >= len(self.visible_findings):
            return
        finding = self.visible_findings[row]

        dlg = FindingEditDialog(finding=finding, assessments=self.assessments_cache, parent=self)
        if dlg.exec() == QDialog.Accepted:
            data = dlg.get_data()
            finding.title = data["title"]
            finding.severity = data["severity"]
            finding.validation_status = data["validation_status"]
            finding.affected_asset = data["affected_asset"]
            finding.affected_port_service = data["affected_port_service"]
            finding.assessment_id = data["assessment_id"]
            finding.confidence = data["confidence"]
            finding.description = data["description"]
            finding.reproduction_steps = data["reproduction_steps"]
            finding.remediation = data["remediation"]
            self.db.update_finding(finding)
            self.load_findings(self.active_project_id)
            self.export_status.setText(f"✓ Updated finding #{finding.id}")

    def _on_delete_finding(self):
        if self.active_project_id is None:
            return
        selected = self.table.selectedItems()
        if not selected:
            QMessageBox.warning(self, "No Selection", "Please select a finding to delete.")
            return
        row = selected[0].row()
        if row >= len(self.visible_findings):
            return
        finding = self.visible_findings[row]

        confirm = QMessageBox.question(
            self,
            "Confirm Delete",
            f"Are you sure you want to delete finding #{finding.id} '{finding.title}'?",
            QMessageBox.Yes | QMessageBox.No,
        )
        if confirm == QMessageBox.Yes:
            self.db.delete_finding(finding.id)
            self.load_findings(self.active_project_id)
            self.export_status.setText(f"✓ Deleted finding #{finding.id}")

    def _on_quick_status(self):
        if self.active_project_id is None:
            return
        selected = self.table.selectedItems()
        if not selected:
            QMessageBox.warning(self, "No Selection", "Please select a finding to update status.")
            return
        row = selected[0].row()
        if row >= len(self.visible_findings):
            return
        finding = self.visible_findings[row]

        # Status transition dialog
        dlg = QDialog(self)
        dlg.setWindowTitle(f"Update Status — #{finding.id}")
        dlg.setMinimumWidth(320)
        d_layout = QVBoxLayout(dlg)
        d_layout.addWidget(QLabel(f"Update status for: <b>{finding.title}</b>"))

        combo = QComboBox()
        statuses = [
            ("New", ValidationStatus.NEW),
            ("Confirmed", ValidationStatus.CONFIRMED),
            ("False Positive", ValidationStatus.FALSE_POSITIVE),
            ("Remediation in Progress", ValidationStatus.REMEDIATION_IN_PROGRESS),
            ("Resolved", ValidationStatus.RESOLVED),
            ("Accepted Risk", ValidationStatus.ACCEPTED_RISK),
            ("Unverified", ValidationStatus.UNVERIFIED),
        ]
        for label, st in statuses:
            combo.addItem(label, st)
        idx = combo.findData(finding.validation_status)
        if idx >= 0:
            combo.setCurrentIndex(idx)
        d_layout.addWidget(combo)

        btn_row = QHBoxLayout()
        btn_cancel = QPushButton("Cancel")
        btn_cancel.clicked.connect(dlg.reject)
        btn_save = QPushButton("Apply Status")
        btn_save.setProperty("class", "action-primary")
        btn_save.clicked.connect(dlg.accept)
        btn_row.addStretch()
        btn_row.addWidget(btn_cancel)
        btn_row.addWidget(btn_save)
        d_layout.addLayout(btn_row)

        if dlg.exec() == QDialog.Accepted:
            new_st = combo.currentData()
            self.db.update_finding_status(finding.id, new_st)
            self.load_findings(self.active_project_id)
            self.export_status.setText(f"✓ Finding #{finding.id} marked as {new_st.value.upper()}")

    def _set_auto_reports_enabled(self, enabled: bool):
        QSettings("CyberSecuritySuite", "CyberSecuritySuite").setValue(
            "reports/auto_enabled", enabled
        )
        if not enabled:
            self.export_status.setText("Automatic report updates are off.")
            return
        if self.active_project_id is not None:
            self._schedule_auto_report(self.active_project_id, force=True)

    def _schedule_auto_report(self, project_id: int, force: bool = False):
        """Debounce report refreshes after scan, terminal, or finding updates."""
        signature = self._report_data_signature(project_id)
        if not force and signature == self._auto_report_signature:
            return
        self._auto_report_pending_project = project_id
        QTimer.singleShot(700, lambda pid=project_id: self._write_auto_report(pid))

    def _report_data_signature(self, project_id: int):
        project = self.db.get_project(project_id)
        scopes = self.db.list_scopes(project_id)
        findings = self.db.list_findings(project_id)
        executions = self.db.list_executions(project_id)
        evidence = self.db.list_evidence(project_id)
        asset_nodes = self.db.list_asset_nodes(project_id)
        asset_edges = self.db.list_asset_edges(project_id)
        return (
            project_id,
            (project.name, project.client_name, project.description, project.status.value,
             project.start_date, project.end_date, project.authorization_doc, project.sow_reference)
            if project else None,
            tuple((s.id, s.target, s.rule_type.value, s.is_authorized, s.ports_allowed,
                   s.expires_at, s.environment, s.notes) for s in scopes),
            tuple((f.id, f.title, f.severity.value, f.validation_status.value, f.description,
                   f.remediation, f.affected_asset, f.cvss_score) for f in findings),
            tuple((e.id, e.tool_name, e.command, e.status.value, e.exit_code, e.finished_at)
                  for e in executions),
            tuple((e.id, e.sha256_hash, e.file_path, e.description) for e in evidence),
            tuple((node.id, node.node_type, node.value, node.label, node.source_tool)
                  for node in asset_nodes),
            tuple((edge.id, edge.source_node_id, edge.target_node_id, edge.relation_type)
                  for edge in asset_edges),
        )

    def _write_auto_report(self, project_id: int):
        if (not self.auto_report_checkbox.isChecked()
                or self._auto_report_pending_project != project_id
                or self.active_project_id != project_id):
            return
        try:
            project = self.db.get_project(project_id)
            if not project:
                return
            output_dir = Path(__file__).resolve().parents[2] / "reports" / "output" / "auto" / f"project_{project_id}"
            paths = self.report_builder.generate_all(project_id, output_dir, stable_names=True)
            self._auto_report_signature = self._report_data_signature(project_id)
            self.export_status.setText(
                "✓ Auto-updated PDF, HTML, Markdown, and JSON reports: "
                + ", ".join(path.name for path in paths.values())
            )
        except Exception as exc:
            self.export_status.setText(f"Automatic report update failed: {exc}")

