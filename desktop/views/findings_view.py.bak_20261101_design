    def _on_attach_screenshot_poc(self):
        """Attaches an image or screenshot Proof-of-Concept to the selected finding."""
        if self.active_project_id is None:
            QMessageBox.warning(self, "No Project Selected", "Select an active project first.")
            return

        selected = self.table.selectedItems()
        if not selected:
            QMessageBox.warning(self, "No Selection", "Please select a finding to attach proof-of-concept screenshot to.")
            return

        row = selected[0].row()
        if row >= len(self.visible_findings):
            return
        finding = self.visible_findings[row]

        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Select Screenshot POC Image",
            "",
            "Images (*.png *.jpg *.jpeg *.bmp *.gif);;All Files (*)",
        )
        if not file_path:
            return

        src_path = Path(file_path)
        if not src_path.exists():
            return

        import hashlib
        import shutil
        import time

        data = src_path.read_bytes()
        sha256 = hashlib.sha256(data).hexdigest()

        # Destination in evidence vault
        vault_dir = Path("evidence") / f"project_{self.active_project_id}"
        vault_dir.mkdir(parents=True, exist_ok=True)
        dest_filename = f"poc_f{finding.id}_{int(time.time())}_{src_path.name}"
        dest_path = vault_dir / dest_filename
        shutil.copy2(src_path, dest_path)

        suffix = src_path.suffix.lower().replace(".", "")
        mime = f"image/{suffix}" if suffix in ("png", "jpeg", "gif", "bmp") else "image/png"
        if suffix == "jpg":
            mime = "image/jpeg"

        from storage.models import Evidence

        ev = Evidence(
            project_id=self.active_project_id,
            finding_id=finding.id,
            file_path=str(dest_path.resolve()),
            sha256_hash=sha256,
            mime_type=mime,
            description=f"Screenshot Proof of Concept for Finding #{finding.id}: {finding.title}",
        )
        self.db.add_evidence(ev)

        self.export_status.setText(f"✓ Attached Screenshot POC to finding #{finding.id}")
        self._on_selection_changed()
        QMessageBox.information(
            self,
            "POC Attached",
            f"Successfully vaulted screenshot POC for Finding #{finding.id}:\n\n"
            f"File: {dest_path.name}\n"
            f"SHA-256: {sha256}\n\n"
            f"This proof will automatically be embedded in generated CPENT reports.",
        )

