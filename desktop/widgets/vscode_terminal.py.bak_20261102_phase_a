    # -------------------------------------------------------------------------
    # Multi-Terminal Management
    # -------------------------------------------------------------------------

    def create_new_session(self, name: Optional[str] = None, cwd: Optional[str] = None) -> VSCodeTerminalSession:
        """Spawns an independent Bash PTY terminal session with its own tab."""
        self._session_counter += 1
        session_id = f"pty_{self._session_counter}"
        session_name = name or f"Bash {self._session_counter}"
        session_cwd = cwd or self.cwd

        session = VSCodeTerminalSession(
            session_id=session_id,
            name=session_name,
            cwd=session_cwd,
            parent=self,
        )
        session.set_context = lambda p, d: self._apply_session_context(session, p, d)
        session.set_context(self.active_project, self.db)

        # Connect session signals
        session.scan_detected.connect(self._on_scan_detected)
        session.scope_violation.connect(self._on_scope_violation)

        self.sessions.append(session)
        self.stacked_widget.addWidget(session)

        tab_idx = self.session_tab_bar.addTab(session_name)
        self.session_tab_bar.setCurrentIndex(tab_idx)
        self.stacked_widget.setCurrentWidget(session)

        return session

    def close_session(self, index: int):
        """Closes an individual terminal session, terminating its PTY process cleanly."""
        if index < 0 or index >= len(self.sessions):
            return

        session_to_close = self.sessions[index]
        session_to_close.close_pty()

        self.stacked_widget.removeWidget(session_to_close)
        session_to_close.deleteLater()
        self.sessions.pop(index)
        self.session_tab_bar.removeTab(index)

        # If all sessions were closed, auto-spawn a fresh one
        if not self.sessions:
            self.create_new_session(name="Bash 1", cwd=self.cwd)
        else:
            new_idx = max(0, min(index, len(self.sessions) - 1))
            self.session_tab_bar.setCurrentIndex(new_idx)
            self.stacked_widget.setCurrentIndex(new_idx)

    def get_active_session(self) -> Optional[VSCodeTerminalSession]:
        """Returns the currently active VSCodeTerminalSession."""
        idx = self.session_tab_bar.currentIndex()
        if 0 <= idx < len(self.sessions):
            return self.sessions[idx]
        if self.sessions:
            return self.sessions[0]
        return None

    def session_count(self) -> int:
        return len(self.sessions)

    def _on_tab_changed(self, index: int):
        if 0 <= index < len(self.sessions):
            self.stacked_widget.setCurrentIndex(index)
            active = self.sessions[index]
            if active and active.recorder.is_recording:
                self.lbl_record_status.setText(f"🔴 Recording: Active ({len(active.recorder.events)} events)")
                self.btn_toggle_record.setText("⏹️ Stop Recording")
            else:
                status_text = "⚪ Recording: Off" if self.active_project else "⚪ Recording: Disabled (No Project)"
                self.lbl_record_status.setText(status_text)
                self.btn_toggle_record.setText("🔴 Start Recording")

    def _apply_session_context(self, session: VSCodeTerminalSession, project: Optional[Project], db: Optional[Database]):
        session.active_project = project
        session.db = db

