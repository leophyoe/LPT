class PTYSignals(QObject):
    data_received = Signal(str)
    process_exited = Signal(int)


class VSCodeTerminalSession(QWidget):
    """An individual interactive Linux Pseudo-Terminal (PTY) session running xterm.js."""

    scan_detected = Signal(str, str, object, list, str)  # tool, cmd, scan_res, findings, raw_text
    scope_violation = Signal(str, str, str)  # tool, target, reason
    data_received = Signal(str)

    def __init__(self, session_id: str, name: str = "Bash", cwd: Optional[str] = None, parent=None):
        super().__init__(parent)
        self.session_id = session_id
        self.session_name = name
        self.cwd = cwd or os.getcwd()
        self.master_fd: Optional[int] = None
        self.process: Optional[subprocess.Popen] = None
        self._closed: bool = False
        self._reader_thread: Optional[threading.Thread] = None

        self.client_socket: Optional[QWebSocket] = None
        self.server: Optional[QWebSocketServer] = None
        self.signals = PTYSignals()
        self.signals.data_received.connect(self._on_pty_data)

        self.active_project: Optional[Project] = None
        self.db: Optional[Database] = None
        self.recorder = TerminalSessionRecorder()
        self._terminal_buffer: List[str] = []
        self._current_input_line: str = ""
        self._recent_commands: List[str] = []

        self._init_server()
        self._init_pty()
        self._init_ui()

    def _init_server(self):
        """Starts a local loopback WebSocket server for xterm.js bridge."""
        self.server = QWebSocketServer(
            f"CyberSecuritySuiteBridge_{self.session_id}",
            QWebSocketServer.SslMode.NonSecureMode,
            self,
        )
        self.server.listen(QHostAddress.SpecialAddress.LocalHost, 0)
        self.server.newConnection.connect(self._on_client_connected)

    def _init_pty(self):
        """Spawns an interactive login shell inside a Linux pseudo-terminal."""
        self.master_fd, slave_fd = pty.openpty()

        env = dict(os.environ)
        env["TERM"] = "xterm-256color"
        env["COLORTERM"] = "truecolor"

        shell_bin = os.environ.get("SHELL", "/bin/bash")

        self.process = subprocess.Popen(
            [shell_bin],
            preexec_fn=os.setsid,
            stdin=slave_fd,
            stdout=slave_fd,
            stderr=slave_fd,
            close_fds=True,
            cwd=self.cwd,
            env=env,
        )
        os.close(slave_fd)

        def pty_reader():
            while not self._closed and self.master_fd is not None:
                try:
                    fd = self.master_fd
                    if fd is None or self._closed:
                        break
                    data = os.read(fd, 4096)
                    if not data or self._closed:
                        break
                    text = data.decode("utf-8", errors="replace")
                    if not self._closed and hasattr(self, "signals") and self.signals is not None:
                        try:
                            self.signals.data_received.emit(text)
                        except (RuntimeError, AttributeError):
                            break
                except (OSError, ValueError):
                    break

        self._reader_thread = threading.Thread(target=pty_reader, daemon=True)
        self._reader_thread.start()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        # WebEngine View
        from PySide6.QtWebEngineWidgets import QWebEngineView

        self.web_view = QWebEngineView()
        self.web_view.setStyleSheet("background-color: #0b0d13;")

        # HTML file path
        html_file = Path(__file__).parent.parent / "resources" / "terminal" / "terminal.html"
        port = self.server.serverPort() if self.server else 0

        url = QUrl.fromLocalFile(str(html_file.resolve()))
        url.setQuery(f"port={port}")
        self.web_view.load(url)

        layout.addWidget(self.web_view)

    @Slot()
    def _on_client_connected(self):
        if not self.server:
            return
        self.client_socket = self.server.nextPendingConnection()
        self.client_socket.textMessageReceived.connect(self._on_message_from_xterm)
        self.client_socket.disconnected.connect(self._on_client_disconnected)

    @Slot()
    def _on_client_disconnected(self):
        self.client_socket = None

    @Slot(str)
    def _on_message_from_xterm(self, msg: str):
        if not self.master_fd or self._closed:
            return

        try:
            payload = json.loads(msg)
            msg_type = payload.get("type")

            if msg_type == "input":
                data = payload.get("data", "")
                if self.recorder.is_recording:
                    self.recorder.record_input(data)

                if data in ("\r", "\n"):
                    cmd = self._current_input_line.strip()
                    if cmd:
                        # Out-of-Scope Safeguard check
                        allowed, violated_target, reason = self._check_command_scope(cmd)
                        if not allowed:
                            self._current_input_line = ""
                            # Send clear visual notice to xterm.js
                            err_msg = (
                                f"\r\n\x1b[1;31m[-] [SCOPE GUARD] Execution blocked: Target '{violated_target}' is unauthorized for project '{self.active_project.name if self.active_project else 'Unknown'}'.\x1b[0m\r\n"
                                f"\x1b[33m[-] Reason: {reason}\x1b[0m\r\n"
                            )
                            if self.client_socket and self.client_socket.isValid():
                                self.client_socket.sendTextMessage(err_msg)
                            self.scope_violation.emit("terminal", violated_target, reason)
                            return

                        self._recent_commands.append(cmd)
                        if self.recorder.is_recording:
                            self.recorder.record_command(cmd)
                    self._current_input_line = ""
                elif data == "\x7f":
                    self._current_input_line = self._current_input_line[:-1]
                elif len(data) == 1 and data.isprintable():
                    self._current_input_line += data

                os.write(self.master_fd, data.encode("utf-8"))
            elif msg_type == "resize":
                cols = int(payload.get("cols", 80))
                rows = int(payload.get("rows", 24))
                # Set PTY window size using TIOCSWINSZ ioctl
                winsize = struct.pack("HHHH", rows, cols, 0, 0)
                fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, winsize)
        except Exception:
            pass

    def _check_command_scope(self, cmd: str) -> Tuple[bool, str, str]:
        """Validates command against engagement scope. Returns (is_allowed, target, reason)."""
        cmd_lower = cmd.lower()
        sec_tools = ("nmap", "sqlmap", "nikto", "wafw00f", "gobuster", "ffuf", "nuclei", "hydra")
        is_sec_scan = any(re.search(rf"(?:^|[/\\\s]){re.escape(t)}(?:$|[\s.])", cmd_lower) for t in sec_tools)

        if not is_sec_scan:
            return True, "", ""  # Standard Linux commands (pwd, ls, cd, python3, etc.) are always allowed!

        if not self.active_project or not self.db:
            return True, "", ""  # No engagement selected

        try:
            from terminal.ingest import TerminalIngestEngine
            from core.scope import ScopeAuthorizationService
            targets = TerminalIngestEngine.extract_targets(cmd, "")
            if not targets:
                return True, "", ""

            scopes = self.db.list_scopes(self.active_project.id)
            for target_val, target_type in targets:
                check = ScopeAuthorizationService.is_target_authorized(target_val, scopes, project=self.active_project)
                if not check.is_allowed:
                    # Log blocked attempt to database audit trail
                    try:
                        self.db.add_audit_log(EngagementAuditLog(
                            project_id=self.active_project.id,
                            action="out_of_scope_scan_blocked",
                            actor="terminal_scope_guard",
                            details=f"Blocked attempt to run scan against unauthorized target '{target_val}'. Reason: {check.reason}",
                        ))
                    except Exception:
                        pass
                    return False, target_val, check.reason
        except Exception as exc:
            logger.debug("Scope validation error: %s", exc)
        return True, "", ""

    @Slot(str)
    def _on_pty_data(self, text: str):
        """Sends data read from Linux PTY to the xterm.js client and checks for scan completions."""
        self._terminal_buffer.append(text)
        if sum(len(c) for c in self._terminal_buffer) > 500000:
            self._terminal_buffer = self._terminal_buffer[-200:]

        if self.recorder.is_recording:
            self.recorder.record_output(text)

        # Scanner Completion Detection
        if any(marker in text for marker in ("Nmap done:", "sqlmap identified the following", "+ 0 host(s) tested", "Finished", "The site ")):
            if self.active_project and self.db:
                QTimer.singleShot(350, self._check_completed_scan_output)

        if self.client_socket and self.client_socket.isValid():
            self.client_socket.sendTextMessage(text)

        self.data_received.emit(text)

    def _check_completed_scan_output(self):
        """Inspects completed scanner output and triggers user review & confirmation notification."""
        if not self.active_project or not self.db:
            return

        buffered_text = "".join(self._terminal_buffer).strip()
        recorded_text = self.recorder.get_raw_content().strip()
        raw_text = buffered_text if len(buffered_text) >= len(recorded_text) else recorded_text
        if not raw_text:
            return

        plain_text = strip_ansi(raw_text)

        # Detect Nmap
        if "Nmap done:" in plain_text or "Starting Nmap" in plain_text:
            try:
                scan_res = NmapParser.parse_text(plain_text)
                if scan_res and scan_res.hosts and any(h.status == "up" for h in scan_res.hosts):
                    from terminal.ingest import TerminalIngestEngine
                    findings = TerminalIngestEngine._parse_nmap(plain_text, self.active_project.id, None, command="nmap")
                    cmd_match = re.search(r"(?:^|[\$#>])\s*(nmap\s+[^\r\n]+)", plain_text)
                    extracted_cmd = cmd_match.group(1).strip() if cmd_match else "nmap"
                    self.scan_detected.emit("nmap", extracted_cmd, scan_res, findings, raw_text)
                    return
            except Exception as exc:
                logger.debug("Failed parsing Nmap output for notification: %s", exc)

        # Detect Nikto
        if "- Nikto v" in plain_text and any(m in plain_text for m in ("Target IP:", "Target Hostname:")):
            try:
                from terminal.ingest import TerminalIngestEngine
                findings = TerminalIngestEngine._parse_nikto(plain_text, self.active_project.id, None)
                if findings:
                    self.scan_detected.emit("nikto", "nikto", None, findings, raw_text)
                    return
            except Exception as exc:
                logger.debug("Failed parsing Nikto output for notification: %s", exc)

        # Detect WAFW00F
        if "The site " in plain_text and " is behind " in plain_text:
            try:
                from terminal.ingest import TerminalIngestEngine
                findings = TerminalIngestEngine._parse_wafw00f("wafw00f", plain_text, self.active_project.id, None)
                if findings:
                    self.scan_detected.emit("wafw00f", "wafw00f", None, findings, raw_text)
                    return
            except Exception as exc:
                logger.debug("Failed parsing WAFW00F output for notification: %s", exc)

    def write_to_pty(self, data: str):
        """Writes input characters or commands directly to the PTY master fd."""
        if self.master_fd is not None and not self._closed:
            try:
                os.write(self.master_fd, data.encode("utf-8"))
            except Exception:
                pass

    def clear(self):
        """Clears terminal buffer and sends Form Feed (Ctrl+L) to xterm.js."""
        self._terminal_buffer.clear()
        self.write_to_pty("\x0c")

    def stop_pty(self):
        self._closed = True
        if self.process is not None:
            try:
                os.killpg(os.getpgid(self.process.pid), 15)
                self.process.wait(timeout=0.2)
            except Exception:
                try:
                    self.process.kill()
                except Exception:
                    pass
            self.process = None

        if self.master_fd is not None:
            try:
                os.close(self.master_fd)
            except OSError:
                pass
            self.master_fd = None

        if hasattr(self, "_reader_thread") and self._reader_thread and self._reader_thread.is_alive():
            try:
                self._reader_thread.join(timeout=0.2)
            except Exception:
                pass

    def restart_shell(self):
        """Terminates existing shell and spawns a fresh PTY session."""
        self.stop_pty()
        self._closed = False
        self._init_pty()
        if hasattr(self, "web_view") and self.web_view is not None:
            self.web_view.reload()

    def close_pty(self):
        self.stop_pty()
        if hasattr(self, "web_view") and self.web_view is not None:
            try:
                self.web_view.stop()
                self.web_view.deleteLater()
            except Exception:
                pass
            self.web_view = None

        if hasattr(self, "server") and self.server:
            try:
                self.server.close()
            except Exception:
                pass
            self.server = None


