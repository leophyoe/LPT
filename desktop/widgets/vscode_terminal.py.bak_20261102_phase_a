    @Slot(str, str, object, list, str)
    def _on_scan_detected(self, tool: str, cmd: str, scan_res: Any, findings: list, raw_text: str):
        """Displays user-confirmed scanner ingestion notification banner."""
        self._pending_scan_data = {
            "tool": tool,
            "cmd": cmd,
            "scan_res": scan_res,
            "findings": findings,
            "raw_text": raw_text,
        }

        num_hosts = len(scan_res.hosts) if scan_res and hasattr(scan_res, "hosts") and scan_res.hosts else 1
        num_ports = 0
        if scan_res and hasattr(scan_res, "hosts") and scan_res.hosts:
            num_ports = sum(len([p for p in h.ports if p.state == "open"]) for h in scan_res.hosts)

        self.lbl_notification_text.setText(
            f"🛡️ <b>{tool.upper()} scan completed</b> — Review <b>{num_hosts} host(s)</b>, "
            f"<b>{num_ports} open port(s)</b>, and <b>{len(findings)} finding(s)</b>."
        )
        self.notification_bar.show()

    def dismiss_notification(self):
        self.notification_bar.hide()
        self._pending_scan_data = None

    def review_and_sync_pending_scan(self):
        """Opens ScannerResultPreviewDialog for operator review and confirmation."""
        if not self._pending_scan_data:
            return

        tool = self._pending_scan_data["tool"]
        cmd = self._pending_scan_data["cmd"]
        scan_res = self._pending_scan_data["scan_res"]
        findings = self._pending_scan_data["findings"]
        raw_text = self._pending_scan_data["raw_text"]

        dialog = ScannerResultPreviewDialog(
            tool_name=tool,
            command=cmd,
            scan_result=scan_res,
            findings=findings,
            raw_output=raw_text,
            db=self.db,
            project=self.active_project,
            parent=self,
        )

        if dialog.exec() == ScannerResultPreviewDialog.DialogCode.Accepted:
            # Synchronize approved data into SQLite
            self._commit_approved_scan_results(dialog, tool, cmd, raw_text)
            self.dismiss_notification()

    def _commit_approved_scan_results(
        self,
        dialog: ScannerResultPreviewDialog,
        tool_name: str,
        cmd: str,
        raw_text: str,
    ):
        """Persists user-confirmed hosts, ports, and findings with cryptographic evidence."""
        if not self.active_project or not self.db:
            return

        session = self.get_active_session()
        # Save session evidence
        ev_id = None
        exec_id = None
        if session:
            try:
                if not session.recorder.events:
                    session.recorder.start(project_id=self.active_project.id, cwd=session.cwd)
                    session.recorder.record_output(raw_text)
                    session.recorder.stop(exit_status=0)
                res = session.recorder.save_session_as_evidence(db=self.db, project_id=self.active_project.id)
                ev_id = res.evidence.id
                exec_id = res.evidence.execution_id
            except Exception as exc:
                logger.debug("Evidence saving error during confirmed sync: %s", exc)

        # Sync approved hosts & ports
        from core.asset_inventory import AssetInventoryService
        if dialog.confirmed_hosts and self.db:
            try:
                from modules.network.nmap_parser import NmapScanResult
                approved_scan = NmapScanResult(command_args=cmd, hosts=dialog.confirmed_hosts)
                AssetInventoryService(self.db).sync_scan_assets(
                    project_id=self.active_project.id,
                    scan_result=approved_scan,
                    scopes=self.db.list_scopes(self.active_project.id),
                    source_tool=tool_name,
                    evidence_id=ev_id,
                )
            except Exception as exc:
                logger.warning("Failed syncing confirmed scan assets: %s", exc)

        # Persist approved findings
        for f in dialog.confirmed_findings:
            f.project_id = self.active_project.id
            f.execution_id = exec_id
            f.source_tool = tool_name
            self.db.upsert_finding_deduplicated(f)

        self.project_data_updated.emit()
        QMessageBox.information(
            self,
            "Synchronization Complete",
            f"Successfully synchronized {len(dialog.confirmed_hosts)} host(s) and {len(dialog.confirmed_findings)} finding(s) "
            f"into Project '{self.active_project.name}'.\n\nAsset Inventory, Network Map, and Reports updated.",
        )

