    def set_context(self, project: Optional[Project], db: Optional[Database]):
        """Sets active project and database context for all terminal sessions."""
        self.active_project = project
        self.db = db
        for session in self.sessions:
            session.active_project = project
            session.db = db

        if project:
            status_text = "⚪ Recording: Off"
            style = "color: #94a3b8; font-size: 11px;"
        else:
            status_text = "⚪ Recording: Disabled (No Project)"
            style = f"color: {CPENTTheme.MUTED_TEXT}; font-size: 11px;"
        self.lbl_record_status.setText(status_text)
        self.lbl_record_status.setStyleSheet(style)

    @Slot()
    def toggle_recording(self):
        session = self.get_active_session()
        if not session:
            return

        if not self.active_project:
            QMessageBox.warning(
                self,
                "No Active Project",
                "Please select an assessment project in Projects & Scope before recording a terminal session.",
            )
            return

        if not session.recorder.is_recording:
            session.recorder.start(project_id=self.active_project.id, cwd=session.cwd)
            self.btn_toggle_record.setText("⏹️ Stop Recording")
            self.lbl_record_status.setText("🔴 Recording: Active (0 events)")
            self.lbl_record_status.setStyleSheet("color: #ef4444; font-size: 11px; font-weight: bold;")
        else:
            session.recorder.stop(exit_status=0)
            self.btn_toggle_record.setText("🔴 Start Recording")
            self.lbl_record_status.setText(f"⚪ Recording: Stopped ({len(session.recorder.events)} events)")
            self.lbl_record_status.setStyleSheet("color: #94a3b8; font-size: 11px;")

