    @Slot()
    def save_session_evidence(self):
        """Saves current PTY recording as project evidence."""
        session = self.get_active_session()
        if not session:
            return

        if not self.active_project or not self.db:
            QMessageBox.warning(
                self,
                "No Active Project",
                "Please select an assessment project first in Projects & Scope.",
            )
            return

        if not session.recorder.events and not session.recorder.get_raw_content().strip():
            buffered_text = "".join(session._terminal_buffer).strip()
            if buffered_text:
                session.recorder.start(project_id=self.active_project.id, cwd=session.cwd)
                session.recorder.record_output(buffered_text)
                if session._recent_commands:
                    for cmd in session._recent_commands[-10:]:
                        session.recorder.record_command(cmd)
                session.recorder.stop(exit_status=0)
            else:
                QMessageBox.warning(
                    self,
                    "Empty Session",
                    "No terminal session activity recorded yet. Execute commands or scans in the terminal first.",
                )
                return

        try:
            res = session.recorder.save_session_as_evidence(db=self.db, project_id=self.active_project.id)
            self.project_data_updated.emit()
            QMessageBox.information(
                self,
                "Evidence Saved",
                f"Interactive PTY Terminal session successfully recorded as Evidence #{res.evidence.id}!\n\n"
                f"Session ID: {res.session_record.session_id}\n"
                f"Cryptographic SHA-256 Hash:\n{res.sha256_hash}\n\n"
                f"Files Vaulted:\n- Raw ANSI: {Path(res.raw_path).name}\n- Plain Text: {Path(res.plain_path).name}",
            )

            # Prompt for immediate asset ingestion if hosts were discovered
            plain_text = strip_ansi(session.recorder.get_raw_content() or "".join(session._terminal_buffer))
            try:
                from modules.network.nmap_parser import NmapParser
                scan_check = NmapParser.parse_text(plain_text)
                if scan_check and scan_check.hosts:
                    reply = QMessageBox.question(
                        self,
                        "Discovered Assets Detected",
                        f"Evidence #{res.evidence.id} contains {len(scan_check.hosts)} discovered host(s).\n\n"
                        f"Would you like to review and synchronize these discovered hosts into the Project Asset Inventory now?",
                        QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                        QMessageBox.StandardButton.Yes,
                    )
                    if reply == QMessageBox.StandardButton.Yes:
                        self.sync_terminal_output()
            except Exception as exc:
                logger.debug("Automatic ingestion prompt error: %s", exc)
        except Exception as e:
            QMessageBox.critical(self, "Save Error", f"Failed to save terminal session evidence: {e}")

    @Slot()
    def sync_terminal_output(self):
        """Opens ScannerResultPreviewDialog for current terminal output as manual fallback."""
        session = self.get_active_session()
        if not session:
            return

        if not self.active_project or not self.db:
            QMessageBox.warning(
                self,
                "No Active Project",
                "Please select an assessment project first in Projects & Scope.",
            )
            return

        buffered_text = "".join(session._terminal_buffer).strip()
        recorded_text = session.recorder.get_raw_content().strip()
        raw_text = buffered_text if len(buffered_text) >= len(recorded_text) else recorded_text

        if not raw_text.strip():
            # Check for latest session evidence file as fallback
            try:
                ev_dir = Path(__file__).resolve().parents[2] / "storage" / "evidence"
                txt_files = sorted(ev_dir.glob("session_*.txt"), key=lambda p: p.stat().st_mtime, reverse=True)
                if txt_files:
                    with open(txt_files[0], "r", encoding="utf-8", errors="replace") as f:
                        cand_text = f.read().strip()
                        if "Nmap" in cand_text:
                            raw_text = cand_text
            except Exception:
                pass

        if not raw_text.strip():
            QMessageBox.warning(
                self,
                "No Output",
                "No terminal output available to ingest. Run a scan command (e.g. Nmap) in the terminal first.",
            )
            return

        plain_text = strip_ansi(raw_text)
        from modules.network.nmap_parser import NmapParser
        from terminal.ingest import TerminalIngestEngine

        cmd = "nmap"
        if session and session._recent_commands:
            for c in reversed(session._recent_commands):
                if "nmap" in c.lower() or "scan" in c.lower():
                    cmd = c
                    break
        elif "nmap " in plain_text:
            for line in plain_text.splitlines():
                if "nmap " in line:
                    cmd = line.strip()
                    break

        scan_res = None
        findings = []
        try:
            scan_res = NmapParser.parse_text(plain_text)
        except Exception:
            pass

        try:
            findings = TerminalIngestEngine._parse_nmap(plain_text, self.active_project.id, None, command=cmd)
        except Exception:
            pass

        # Open preview dialog for manual confirmation
        dialog = ScannerResultPreviewDialog(
            tool_name="nmap" if "nmap" in cmd.lower() else "terminal",
            command=cmd,
            scan_result=scan_res,
            findings=findings,
            raw_output=raw_text,
            db=self.db,
            project=self.active_project,
            parent=self,
        )

        if dialog.exec() == ScannerResultPreviewDialog.DialogCode.Accepted:
            self._commit_approved_scan_results(dialog, "nmap" if "nmap" in cmd.lower() else "terminal", cmd, raw_text)
